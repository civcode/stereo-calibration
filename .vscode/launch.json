{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [

        {
            "name": "(gdb) Launch read",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/capture_stereo",
            // "args": ["-n", "5", "-i", "left"],
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}/../build",
            "environment": [
                { "name": "DISPLAY", "value": "${env:DISPLAY}" }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "make build",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description":  "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        },

        {
            "name": "(gdb) Launch calibrate",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/calibrate",
            "args": ["-n", "5", "-i", "left"],
            "stopAtEntry": false,
            "cwd": "${fileDirname}/../build",
            "environment": [
                {
                    "name": "DISPLAY",
                    "value": "10.0"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "make build",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description":  "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        }

    ]
}